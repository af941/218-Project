"""Exercise the game API over HTTP using a temporary local server."""

import json
import threading
import unittest
from functools import partial
from http.server import ThreadingHTTPServer
from pathlib import Path
from urllib.error import HTTPError
from urllib.request import Request, urlopen

from app import Handler, PLAYABLE_DATES

# Suppress server log messages during automated testing.
class QuietHandler(Handler):
    def log_message(self, format, *args):
        pass


class DailyDispatchHTTPTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        web = Path(__file__).resolve().parents[1] / "web"
        cls.server = ThreadingHTTPServer(("127.0.0.1", 0), partial(QuietHandler, directory=str(web)))
        cls.addClassCleanup(cls.server.server_close)
        thread = threading.Thread(target=cls.server.serve_forever, kwargs={"poll_interval": 0.01}, daemon=True)
        thread.start()
        cls.addClassCleanup(cls.stop_server, thread)
        cls.base = f"http://127.0.0.1:{cls.server.server_port}"

    @classmethod
    def stop_server(cls, thread):
        cls.server.shutdown()
        thread.join()

    def send(self, payload, path="/api/plan"):
        body = payload if isinstance(payload, bytes) else json.dumps(payload).encode()
        request = Request(self.base + path, data=body, headers={"Content-Type": "application/json"})
        with urlopen(request, timeout=5) as response:
            self.assertEqual(response.headers.get_content_type(), "application/json")
            return json.load(response)

    def test_serves_frontend_assets(self):
        for path, marker in (("/", b'daily-summary'), ("/app.js", b"/api/plan"), ("/style.css", b".board")):
            with self.subTest(path=path), urlopen(self.base + path, timeout=5) as response:
                self.assertEqual(response.status, 200)
                self.assertIn(marker, response.read())

    def test_draw_submit_and_replay(self):
        drawn = self.send({})
        self.assertIn(drawn["day"], PLAYABLE_DATES)
        start = self.send({"day": "2025-10-01"})
        plan = [{"id": "REQ-00001", "cargo": [1, 2, 256]}]
        result = self.send({"day": start["day"], "draft": plan, "finish": True})
        self.assertTrue(result["finished"])
        self.assertEqual(result["comparison"]["player"]["beneficiaries"], 657)
        self.assertEqual(self.send({"day": start["day"]}), start)

    def test_bad_payloads_return_json_errors(self):
        for payload in (b"", b"{", [], {"day": "2099-01-01"}, {"draft": {}}, {"finish": "yes"}):
            with self.subTest(payload=payload), self.assertRaises(HTTPError) as failure:
                self.send(payload)
            with failure.exception as error:
                self.assertEqual(error.code, 400)
                self.assertIn("error", json.load(error))

    def test_invalid_shipment_does_not_poison_a_retry(self):
        day = "2025-10-01"
        start = self.send({"day": day})
        good = {"id": "REQ-00001", "cargo": [1, 0, 0]}
        bad_shipments = (
            [good, good],
            [good, {"id": "REQ-99999", "cargo": [1, 0, 0]}],
            [good, {"id": "REQ-00003", "cargo": [999_999, 0, 0]}],
            [{"id": "REQ-00001", "cargo": None}],
        )
        for draft in bad_shipments:
            with self.subTest(draft=draft), self.assertRaises(HTTPError) as failure:
                self.send({"day": day, "draft": draft, "finish": True})
            with failure.exception as error:
                self.assertEqual(error.code, 400)
            self.assertEqual(self.send({"day": day}), start)
        self.assertTrue(self.send({"day": day, "draft": [good], "finish": True})["finished"])

    def test_unknown_endpoint_returns_404(self):
        with self.assertRaises(HTTPError) as failure:
            self.send({}, path="/api/unknown")
        with failure.exception as error:
            self.assertEqual(error.code, 404)
