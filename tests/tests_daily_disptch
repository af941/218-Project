"""Functional and regression tests for the Daily Dispatch simulation."""

import unittest
from copy import deepcopy
from unittest.mock import patch

from app import PLAYABLE_DATES, play
from simulation import BY_DAY, Day, State


DAY = "2025-10-01"
REQUEST_ID = "REQ-00001"
HUB_ID = "HUB-ARI"


class DayAllocationTests(unittest.TestCase):
    def setUp(self):
        self.day = Day(DAY)
        self.request = self.day.requests[REQUEST_ID]
        self.hub = self.day.limits[HUB_ID]

    def test_full_dispatch_deducts_stock_weight_and_one_slot(self):
        self.assertEqual(self.request.location, "Deir al-Balah")
        self.assertEqual(self.request.hub, HUB_ID)
        self.assertEqual(self.request.demand, [2, 4, 512])
        self.assertEqual(self.hub["stock"], [3239, 2055, 24651])
        self.assertEqual(self.hub["slots"], 4)
        other_hub = deepcopy(self.day.limits["HUB-AMM"])

        self.day.dispatch(REQUEST_ID, [2, 4, 512])

        self.assertEqual(self.request.history, ["Pending", "Dispatched", "Fulfilled"])
        self.assertEqual(self.hub["stock"], [3237, 2051, 24139])
        self.assertEqual(self.hub["slots"], 3)
        self.assertEqual(self.hub["kg"], 120_000 - 2_624)
        self.assertEqual(self.day.limits["HUB-AMM"], other_hub)
        self.assertEqual(self.request.served, 1314)
        self.assertEqual(self.request.late, 0)

    def test_partial_dispatch_estimates_half_the_beneficiaries(self):
        self.day.dispatch(REQUEST_ID, [1, 2, 256])

        self.assertEqual(self.request.history, ["Pending", "Dispatched", "Partially fulfilled"])
        self.assertEqual(self.request.served, 657)
        self.assertIn("submitted shipment", self.request.explanation)

    def test_exact_capacity_and_stock_are_allowed(self):
        self.hub.update(stock=[2, 4, 512], slots=1, kg=2_624, per_trip_kg=2_624)
        self.day.dispatch(REQUEST_ID, [2, 4, 512])
        self.assertEqual(self.hub["stock"], [0, 0, 0])
        self.assertEqual(self.hub["slots"], 0)
        self.assertEqual(self.hub["kg"], 0)

    def test_ai_scales_cargo_to_a_tight_weight_limit(self):
        self.hub["per_trip_kg"] = 1_312
        self.day.dispatch(REQUEST_ID)
        self.assertEqual(self.request.allocated, [1, 2, 256])
        self.assertEqual(self.request.state, State.PARTIAL)

    def test_missing_transit_uses_accessibility_fallback(self):
        self.assertEqual(self.day.requests["REQ-00002"].eta, 16)

    def test_dispatch_lateness_is_transit_time_minus_deadline(self):
        self.request.eta = 15

        self.day.dispatch(REQUEST_ID, [2, 4, 512])

        self.assertEqual(self.request.late, 3)

    def test_invalid_cargo_leaves_request_and_resources_unchanged(self):
        starting_limits = deepcopy(self.hub)
        invalid_shipments = ([0, 0, 0], [-1, 0, 1], [1.5, 0, 1], [True, 0, 1],
                             [1, 2], [3, 0, 0])
        for shipment in invalid_shipments:
            with self.subTest(shipment=shipment):
                with self.assertRaises(ValueError):
                    self.day.dispatch(REQUEST_ID, shipment)
                self.assertEqual(self.request.state, State.PENDING)
                self.assertEqual(self.hub, starting_limits)

    def test_stock_slots_and_both_cargo_limits_are_enforced(self):
        restrictions = (
            {"stock": [1, 4, 512]},
            {"slots": 0},
            {"kg": 2_623},
            {"per_trip_kg": 2_623},
        )
        for changes in restrictions:
            with self.subTest(changes=changes):
                day = Day(DAY)
                hub = day.limits[HUB_ID]
                hub.update(changes)
                limits_before = deepcopy(hub)
                with self.assertRaises(ValueError):
                    day.dispatch(REQUEST_ID, [2, 4, 512])
                self.assertEqual(hub, limits_before)
                self.assertEqual(day.requests[REQUEST_ID].state, State.PENDING)

    def test_two_requests_share_the_same_hub_stock(self):
        self.hub["stock"] = [2, 4, 512]
        self.day.dispatch(REQUEST_ID, [2, 4, 512])

        with self.assertRaises(ValueError):
            self.day.dispatch("REQ-00003", [1, 0, 0])
        self.assertEqual(self.day.requests["REQ-00003"].state, State.PENDING)

    def test_a_request_cannot_be_dispatched_twice(self):
        self.day.dispatch(REQUEST_ID, [1, 0, 0])
        limits_after_first_dispatch = deepcopy(self.hub)

        with self.assertRaises(ValueError):
            self.day.dispatch(REQUEST_ID, [1, 0, 0])
        self.assertEqual(self.hub, limits_after_first_dispatch)

    def test_fuzzy_and_fifo_choose_different_requests_with_one_slot(self):
        fuzzy, fifo = Day(DAY), Day(DAY)
        fuzzy.limits[HUB_ID]["slots"] = 1
        fifo.limits[HUB_ID]["slots"] = 1

        fuzzy.finish("fuzzy")
        fifo.finish("fifo")

        self.assertEqual(fuzzy.requests[REQUEST_ID].state, State.FULFILLED)
        self.assertEqual(fifo.requests[REQUEST_ID].state, State.UNFULFILLED)
        self.assertEqual(fifo.requests["REQ-00003"].state, State.FULFILLED)


class GameFlowTests(unittest.TestCase):
    def test_draw_selects_a_playable_date_and_excludes_the_previous_one(self):
        with patch("app.choice", side_effect=lambda dates: dates[0]) as choose:
            start = play({})
            next_day = play({"previous": start["day"]})

        self.assertIn(next_day["day"], PLAYABLE_DATES)
        self.assertGreaterEqual(len(next_day["requests"]), 2)
        self.assertNotIn(start["day"], choose.call_args.args[0])
        self.assertNotEqual(start["day"], next_day["day"])

    def test_replay_restores_starting_resources(self):
        initial = play({"day": DAY})
        play({"day": DAY, "finish": True, "draft": [{"id": REQUEST_ID, "cargo": [1, 0, 0]}]})

        self.assertEqual(play({"day": DAY}), initial)

    def test_empty_plan_leaves_all_requests_unfulfilled(self):
        result = play({"day": DAY, "finish": True, "draft": []})

        self.assertTrue(result["finished"])
        self.assertTrue(all(r["state"] == "Unfulfilled" for r in result["requests"]))
        player = result["comparison"]["player"]
        self.assertEqual(player["beneficiaries"], 0)
        self.assertIsNone(player["delay"])
        self.assertIsNone(player["fairness"])

    def test_result_includes_all_comparison_policies(self):
        outcome = play({"day": DAY, "finish": True})
        self.assertEqual(set(outcome["comparison"]), {"player", "fuzzy", "fifo", "recorded"})

    def test_ai_draft_lists_highest_priority_shipment_first(self):
        start = play({"day": DAY})
        self.assertEqual(start["recommendation"][0]["id"], REQUEST_ID)

    def test_ai_draft_matches_fuzzy_comparison_on_every_playable_date(self):
        for day in PLAYABLE_DATES:
            with self.subTest(day=day):
                start = play({"day": day})
                result = play({"day": day, "draft": start["recommendation"], "finish": True})
                self.assertEqual(len(result["requests"]), len(BY_DAY[day]))
                self.assertEqual(result["comparison"]["player"], result["comparison"]["fuzzy"])


if __name__ == "__main__":
    unittest.main()
